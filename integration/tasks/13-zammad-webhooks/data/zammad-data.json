      "updated_at": "2024-10-01T14:00:00Z",
      "note": "Customer requesting higher API limits",
      
      "articles": [
        {
          "id": "article_4",
          "subject": "API rate limit too restrictive",
          "body": "Hello,\n\nWe're building an integration with your API but keep hitting the rate limit of 100 requests/minute. For our use case, we need to sync data for thousands of users every hour.\n\nIs there a way to increase our rate limit? We're on the Business plan.\n\nTechnical details:\n- Current limit: 100 req/min\n- Our requirement: ~500 req/min\n- Use case: User data synchronization\n- Plan: Business (annual)\n\nPlease advise on next steps.\n\nThanks,\nMike",
          "type": "note",
          "internal": false,
          "sender": "Customer",
          "from": "mike.customer@techstart.io",
          "created_by_id": "user_3",
          "created_at": "2024-10-01T14:00:00Z"
        }
      ]
    },
    
