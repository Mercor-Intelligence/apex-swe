FROM ghcr.io/zammad/zammad:latest

USER root

# Install minimal services we need inside the same container
# - postgresql (server + client), redis, memcached, tini, gosu for privilege drops
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      postgresql postgresql-contrib \
      redis-server \
      memcached \
      gosu tini \
      python3 python3-requests \
    && rm -rf /var/lib/apt/lists/*

# Create postgres data dir and allow container-managed postgres
RUN mkdir -p /var/lib/postgresql/data && chown -R postgres:postgres /var/lib/postgresql

# Persist Zammad storage (attachments) to a known mount
VOLUME ["/opt/zammad/storage", "/var/lib/postgresql/data"]

# Copy entrypoint that starts *everything*
COPY shared/dockerfiles/docker-entrypoint-zammad-lightweight.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Copy Zammad config json
COPY shared/config/zammad-auto-wizard.json /usr/local/bin/zammad-auto-wizard.json

# We’ll expose nginx port 8080 (matches official image default)
EXPOSE 8080

# Use tini to handle signals properly
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/docker-entrypoint.sh"]
