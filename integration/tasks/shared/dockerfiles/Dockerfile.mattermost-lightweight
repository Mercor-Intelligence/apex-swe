# Lightweight Mattermost with embedded PostgreSQL
FROM mattermost/mattermost-team-edition:8.1.1

# Switch to root to install packages
USER root

# Install PostgreSQL, Python, and Node.js (for MCP servers)
# Mattermost image is based on Ubuntu/Debian
RUN apt-get update && \
    apt-get install -y postgresql-14 postgresql-client-14 sudo python3 python3-pip curl && \
    pip3 install psycopg2-binary && \
    # Install Node.js 18 for MCP servers
    curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy the entrypoint script
COPY shared/dockerfiles/docker-entrypoint-mattermost-lightweight.sh /docker-entrypoint-mattermost-lightweight.sh
RUN chmod +x /docker-entrypoint-mattermost-lightweight.sh

# Set environment
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Entrypoint
ENTRYPOINT ["/bin/bash", "/docker-entrypoint-mattermost-lightweight.sh"]
