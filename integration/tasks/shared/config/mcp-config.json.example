{
  "mcpServers": {
    "plane": {
      "type": "stdio",
      "command": "node",
      "args": ["ABSOLUTE_PATH_TO_REPO/mcp-servers/plane/build/index.js"],
      "env": {
        "PLANE_API_BASE_URL": "http://localhost:8000",
        "PLANE_API_TOKEN": "your_plane_api_token_here",
        "PLANE_API_KEY": "your_plane_api_token_here",
        "PLANE_WORKSPACE_SLUG": "your_workspace_slug_here"
      }
    },
    "mattermost": {
      "type": "stdio",
      "command": "node",
      "args": ["ABSOLUTE_PATH_TO_REPO/mcp-servers/mattermost-official/dist/main.js"],
      "env": {
        "MATTERMOST_URL": "http://localhost:8065",
        "MATTERMOST_TOKEN": "your_mattermost_token_here",
        "MATTERMOST_ENDPOINT": "http://localhost:8065/api/v4",
        "MATTERMOST_TEAM": "your_team_name_here"
      }
    },
    "grafana-loki": {
      "command": "uvx",
      "args": [
        "grafana-loki-mcp",
        "-u",
        "GRAFANA_URL",
        "-k",
        "GRAFANA_API_KEY"
      ],
      "env": {
        "GRAFANA_URL": "http://grafana:3000",
        "GRAFANA_API_KEY": "your_grafana_api_key_here"
      }
    },
    "prometheus": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "PROMETHEUS_URL",
        "ghcr.io/pab1it0/prometheus-mcp-server:latest"
      ],
      "env": {
        "PROMETHEUS_URL": "http://prometheus:9090"
      }
    }
  }
}
