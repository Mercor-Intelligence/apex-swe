#!/usr/bin/env bash
# Grafana-Loki MCP server wrapper
# Auto-sources environment variables from /config/mcp-config.txt if available
# This allows using: { echo '...'; } | mcp-loki

set -a
[ -f /config/mcp-config.txt ] && source /config/mcp-config.txt
set +a

# Execute the Grafana-Loki MCP server
exec python3 -m grafana_loki_mcp

