# ApexCode Observability - Environment Variables
# ==============================================
# Copy this file to .env and fill in your API keys:
#   cp env.example .env
#
# The .env file is gitignored and will not be committed.
# These keys are used for LLM model access during agent evaluations.

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================
# Set the API keys for the providers you want to use.
# You only need keys for the models you plan to use.

# Anthropic (Claude models: claude-opus-4-5, claude-sonnet-4-5)
ANTHROPIC_API_KEY=

# OpenAI (GPT models: gpt-5.1-codex)
OPENAI_API_KEY=

# Google (Gemini models: gemini-3-pro)
GOOGLE_API_KEY=

# xAI (Grok models: grok-4)
XAI_API_KEY=

# Fireworks (Kimi, Qwen, DeepSeek models: kimi-k2, qwen3-coder, deepseek-v3)
FIREWORKS_API_KEY=

# Cognition (OpenAI-compatible endpoint: cognition)
COGNITION_API_KEY=
COGNITION_BASE_URL=

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Default model to use (if not specified in command)
# DEFAULT_MODEL=claude-opus-4-5

# Evaluation time limit in seconds (default: 3600 = 1 hour)
# EVAL_TIME_LIMIT=3600

# Message limit for agent (default: 250)
# EVAL_MESSAGE_LIMIT=250

# Test execution timeout in seconds (default: 900 = 15 minutes)
# EVAL_TEST_TIMEOUT=900
