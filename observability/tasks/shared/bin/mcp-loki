#!/usr/bin/env bash
# Grafana-Loki MCP server wrapper
# Sources environment variables and generates config on-demand if missing

CONFIG_FILE="/config/mcp-config.txt"

# Debug: show config file status
echo "DEBUG: Config file check:" >&2
if [ -f "$CONFIG_FILE" ]; then
    echo "  - File exists: $CONFIG_FILE" >&2
    echo "  - Size: $(wc -c < "$CONFIG_FILE") bytes" >&2
    echo "  - Grafana lines:" >&2
    grep -i grafana "$CONFIG_FILE" 2>/dev/null | head -5 | sed 's/^/    /' >&2 || echo "    (none found)" >&2
else
    echo "  - File DOES NOT exist: $CONFIG_FILE" >&2
fi

# Source config file and export all variables
if [ -f "$CONFIG_FILE" ]; then
    set -a
    source "$CONFIG_FILE"
    set +a
fi

echo "DEBUG: After sourcing - GRAFANA_URL=${GRAFANA_URL:-<not set>}" >&2

# Function to create Grafana config
create_grafana_config() {
    # Create service account and token
    local sa_resp sa_id token_resp token
    
    sa_resp=$(curl -s -u "admin:admin" -H "Content-Type: application/json" \
        -X POST http://grafana:3000/api/serviceaccounts \
        -d '{"name":"mcp-loki-ondemand","role":"Admin"}' 2>/dev/null)
    sa_id=$(echo "$sa_resp" | jq -r '.id // empty' 2>/dev/null)
    
    # If creation failed, try to find existing
    if [ -z "$sa_id" ] || [ "$sa_id" = "null" ]; then
        local sa_list
        sa_list=$(curl -s -u "admin:admin" 'http://grafana:3000/api/serviceaccounts/search?perpage=500' 2>/dev/null)
        sa_id=$(echo "$sa_list" | jq -r '.serviceAccounts[]? | select(.name | contains("mcp-loki")) | .id' 2>/dev/null | head -n 1)
        
        # Try alternate API format
        if [ -z "$sa_id" ] || [ "$sa_id" = "null" ]; then
            sa_list=$(curl -s -u "admin:admin" 'http://grafana:3000/api/serviceaccounts?perpage=500' 2>/dev/null)
            sa_id=$(echo "$sa_list" | jq -r '.[]? | select(.name | contains("mcp-loki")) | .id' 2>/dev/null | head -n 1)
        fi
    fi
    
    if [ -z "$sa_id" ] || [ "$sa_id" = "null" ]; then
        echo "   Failed to create/find service account" >&2
        return 1
    fi
    
    echo "   Service account ID: $sa_id" >&2
    
    # Create token
    token_resp=$(curl -s -u "admin:admin" -H "Content-Type: application/json" \
        -X POST "http://grafana:3000/api/serviceaccounts/$sa_id/tokens" \
        -d "{\"name\":\"mcp-token-$(date +%s)\"}" 2>/dev/null)
    token=$(echo "$token_resp" | jq -r '.key // .token // empty' 2>/dev/null)
    
    if [ -z "$token" ] || [ "$token" = "null" ]; then
        echo "   Failed to create API token" >&2
        return 1
    fi
    
    export GRAFANA_URL="http://grafana:3000"
    export GRAFANA_API_KEY="$token"
    export GRAFANA_DATASOURCE_UID="1"
    
    # Save to config file for future use
    {
        echo ""
        echo "# Grafana config (generated on-demand by mcp-loki wrapper)"
        echo "export GRAFANA_URL=http://grafana:3000"
        echo "export GRAFANA_API_KEY=$token"
        echo "export GRAFANA_DATASOURCE_UID=1"
    } >> "$CONFIG_FILE"
    
    echo "✅ Grafana token generated successfully" >&2
    return 0
}

# If Grafana config is missing, try to generate it on-demand
if [ -z "$GRAFANA_URL" ] || [ -z "$GRAFANA_API_KEY" ] || [[ "$GRAFANA_API_KEY" == *"placeholder"* ]]; then
    echo "⏳ Grafana config missing, attempting to generate..." >&2
    
    grafana_ready=false
    
    # Wait for Grafana to be ready (increased timeout to 120s)
    for i in {1..120}; do
        # Try health check with flexible pattern
        health_resp=$(curl -s http://grafana:3000/api/health 2>/dev/null)
        
        # Check for healthy database status (flexible pattern matching)
        if echo "$health_resp" | grep -qE '"database"[[:space:]]*:[[:space:]]*"ok"'; then
            echo "✅ Grafana is ready (health check passed)" >&2
            grafana_ready=true
            break
        fi
        
        # Fallback: check if we get any valid JSON response with database field
        if echo "$health_resp" | grep -q '"database"'; then
            echo "✅ Grafana is responding (database field present)" >&2
            grafana_ready=true
            break
        fi
        
        # Last resort: check HTTP status code
        http_code=$(curl -s -o /dev/null -w '%{http_code}' http://grafana:3000/api/health 2>/dev/null)
        if [ "$http_code" = "200" ]; then
            echo "✅ Grafana is responding (HTTP 200)" >&2
            grafana_ready=true
            break
        fi
        
        if [ $((i % 15)) -eq 0 ]; then
            echo "   Waiting for Grafana... ($i/120)" >&2
            echo "   Health response: $health_resp" >&2
        fi
        sleep 1
    done
    
    if [ "$grafana_ready" = true ]; then
        # Give Grafana a moment to fully initialize
        sleep 2
        create_grafana_config
    else
        echo "❌ Grafana not available after 120s timeout" >&2
    fi
fi

# Final check
if [ -z "$GRAFANA_URL" ] || [ -z "$GRAFANA_API_KEY" ] || [[ "$GRAFANA_API_KEY" == *"placeholder"* ]]; then
    echo "" >&2
    echo "================================================================" >&2
    echo "Error: Could not configure Grafana MCP. Use direct Loki API instead:" >&2
    echo "" >&2
    echo "  curl -sG 'http://loki:3100/loki/api/v1/query_range' \\" >&2
    echo "    --data-urlencode 'query={job=\"YOUR_TASK_NAME\"}' \\" >&2
    echo "    --data-urlencode 'limit=100' | jq '.data.result[].values[][1]'" >&2
    echo "" >&2
    echo "This direct API call does not require authentication." >&2
    echo "================================================================" >&2
    exit 1
fi

# Run the Grafana-Loki MCP server
# Use a subshell that reads all stdin first, then feeds it to the server
# while keeping the pipe open long enough for the response.
# FastMCP 3.0.0 tears down the write stream when stdin closes, so we
# need stdin to stay open until the server finishes processing.
if [ ! -t 0 ]; then
    # stdin is a pipe — buffer it and add a delay to keep pipe alive
    INPUT=$(cat)
    (echo "$INPUT"; sleep 30) | python3 -m grafana_loki_mcp "$@"
else
    exec python3 -m grafana_loki_mcp "$@"
fi