# Lightweight Plane environment (no Redis/RabbitMQ; eager Celery; in-memory broker)

# Database Settings - In-memory PostgreSQL in same container
DJANGO_SETTINGS_MODULE=plane.settings.production
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane_password
POSTGRES_DB=plane
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis enabled (running in same container)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=true
CACHE_BACKEND=redis
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DISABLE_RATE_LIMITING=0

# Celery: eager, no external broker/backend
CELERY_ALWAYS_EAGER=true
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# RabbitMQ disabled
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# Base URLs (proxy optional if UI disabled); API external URL for lightweight
WEB_URL=http://localhost:8001
APP_BASE_URL=http://localhost:8001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8001

# Storage disabled in lightweight
USE_MINIO=0
AWS_REGION=
AWS_ACCESS_KEY_ID=plane-access-key
AWS_SECRET_ACCESS_KEY=plane-secret-key
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# Security
SECRET_KEY=plane-demo-secret-key-change-in-production
DEBUG=1

# Auth toggles
ENABLE_SIGNUP=true
ENABLE_EMAIL_PASSWORD=true
ENABLE_MAGIC_LINK_LOGIN=false
DISABLE_WORKSPACE_CREATION=false
ENABLE_SMTP=false
EMAIL_FROM=admin@demo.local
DEFAULT_EMAIL=admin@demo.local

# Workers
GUNICORN_WORKERS=2

# Live server
LIVE_SERVER_SECRET_KEY=live-secret-key

# High API key limit to avoid rate-limiting in demos
API_KEY_RATE_LIMIT=999999/minute

# Dockerized flag
DOCKERIZED=1
